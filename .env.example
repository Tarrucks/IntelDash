# ============================================================================
# Aperture — environment template
# ----------------------------------------------------------------------------
# Copy to .env and fill in. NOTHING in this file is secret; .env is gitignored.
# The platform boots end-to-end with ALL adapter keys blank (mock mode).
# A real adapter activates only when its required env vars are non-empty.
# ============================================================================

# --- Core infra ---------------------------------------------------------------
POSTGRES_USER=aperture
POSTGRES_PASSWORD=aperture
POSTGRES_DB=aperture
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aperture:aperture@db:5432/aperture

REDIS_URL=redis://redis:6379/0

# --- Auth ---------------------------------------------------------------------
# A 32+ byte random secret. The setup script will generate one if blank.
JWT_SECRET=
JWT_ALG=HS256
JWT_TTL_MINUTES=60

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# MapLibre style URL. Default is a free demo style; swap in your own if needed.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ============================================================================
# Source adapters — leave blank to run in mock mode
# ============================================================================

# Shodan — https://developer.shodan.io/api  (query-string `key` auth, credits)
SHODAN_API_KEY=

# Exa — https://docs.exa.ai  (x-api-key header)
EXA_API_KEY=

# AISHub — http://data.aishub.net/ws.php  (members; 1 request / minute cap)
AISHUB_USERNAME=

# BarentsWatch Historic AIS — OAuth2 client_credentials, scope=ais
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=

# Flightradar24 — https://fr24api.flightradar24.com  (sandbox key works for tests)
FR24_API_KEY=

# Kaggle (one-shot seed download of the AIS dataset)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Feature flags ------------------------------------------------------------
# When false, all adapters are forced into mock mode regardless of keys.
APERTURE_USE_REAL_ADAPTERS=true
# Auto-load Kaggle AIS seed on first backend boot.
APERTURE_SEED_ON_BOOT=true
