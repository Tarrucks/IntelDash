{
  "name": "aperture-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Aperture OSINT platform — Next.js frontend",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.30",
    "@deck.gl/layers": "^9.0.30",
    "@deck.gl/mapbox": "^9.0.30",
    "@deck.gl/react": "^9.0.30",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^4.7.1",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "^7.1.7",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2"
